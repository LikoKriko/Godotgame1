extends SceneTree
const Motion = preload("res://scripts/interaction_motion.gd")
var failures := 0
func require(ok: bool,message: String):
	if not ok: failures += 1; push_error(message)
func _initialize():
	var motion = Motion.new()
	motion.draw_object()
	require(is_equal_approx(motion.speed_multiplier(),0.95),"Drawing starts with exactly 5 percent less speed")
	motion.advance(0.5)
	require(is_equal_approx(motion.speed_multiplier(),0.975),"Half the penalty has recovered after half a second")
	motion.advance(0.5)
	require(motion.speed_multiplier() == 1,"Drawing recovers completely after one second")
	require(motion.pick_up() and not motion.pick_up(),"A pickup cannot restart itself before completing")
	motion.advance(0.18)
	require(is_equal_approx(motion.speed_multiplier(),0.4) and is_equal_approx(motion.pickup_phase(),0.5),"Pickup reaches contact at half its 0.36 second duration with a 60 percent slowdown")
	motion.advance(0.18)
	require(not motion.picking_up() and is_equal_approx(motion.speed_multiplier(),0.4),"Recovery begins after the animation completes")
	motion.advance(0.25)
	require(is_equal_approx(motion.speed_multiplier(),0.7),"Pickup slowdown decreases progressively over the recovery")
	motion.advance(0.25)
	require(motion.speed_multiplier() == 1,"Pickup recovers completely after 0.5 seconds")
	motion.pick_up(); motion.advance(0.86)
	require(not motion.picking_up() and motion.speed_multiplier() == 1,"A long frame preserves overflow into recovery")
	print("%s: interaction timing and progressive speed recovery" % ["PASS" if failures == 0 else "FAIL"])
	quit(0 if failures == 0 else 1)
