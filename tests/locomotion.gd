extends SceneTree
const Motion = preload("res://scripts/locomotion.gd")
var checks := 0
var failures := 0
func _initialize() -> void: call_deferred("run")
func require(condition: bool,message: String) -> void:
	checks += 1
	if not condition:
		failures += 1
		push_error(message)
func run() -> void:
	var motion := Motion.new()
	require(not motion.slide(Vector2.ZERO),"Standing cannot initiate a slide")
	require(motion.jump() and not motion.jump(),"Only grounded characters can initiate a jump")
	require(not motion.slide(Vector2.RIGHT),"Jump and slide cannot overlap")
	motion.advance(Motion.JUMP_SECONDS/2,false)
	require(is_equal_approx(motion.height(),24),"Jump reaches its designed apex")
	motion.advance(Motion.JUMP_SECONDS/2,false)
	require(not motion.airborne() and motion.height() == 0,"Landing returns exactly to ground")
	motion.advance(0.16,true)
	require(is_equal_approx(motion.crouch,1) and is_equal_approx(motion.speed_factor(),0.48),"Crouching lowers the body and slows travel")
	motion.advance(0.16,false)
	require(motion.crouch == 0,"Standing recovers smoothly")
	require(motion.slide(Vector2.RIGHT),"Moving character initiates a slide")
	var initial := motion.velocity(Vector2.LEFT,1)
	motion.advance(0.2,false)
	var later := motion.velocity(Vector2.LEFT,1)
	require(initial.x > later.x and later.x > 0,"Slide retains its direction and loses momentum")
	motion.advance(0.3,false)
	require(not motion.sliding() and not motion.slide(Vector2.RIGHT),"Slide ends and cooldown prevents chaining")
	motion.advance(0.5,false)
	require(motion.slide(Vector2.RIGHT),"Cooldown eventually allows another slide")
	var game = load("res://scenes/main.tscn").instantiate()
	root.add_child(game)
	game.set_process(false)
	game.bag.unequip(&"tool")
	game._process(0.01)
	require(game.start_jump(),"Game exposes a functioning jump action")
	require(not game.start_work(game.player+Vector2(20,0)),"Cannot harvest in midair")
	game._process(Motion.JUMP_SECONDS/2)
	var apex: float = game.locomotion.height()
	require(apex > 23 and game.full_avatar.state == &"jump","Jump raises the complete rendered body without moving its ground reference")
	game.inventory_panel.show()
	var paused: float = game.locomotion.jump_elapsed
	game._process(0.2)
	require(game.locomotion.jump_elapsed == paused,"Inventory pauses locomotion timers")
	game.inventory_panel.hide()
	game._process(Motion.JUMP_SECONDS)
	game.movement.step(Vector2.RIGHT,1,220)
	require(not game.start_slide(),"Walking cannot initiate a slide")
	game.running = true
	require(game.start_slide(),"Running starts a directional slide")
	var start: Vector2 = game.player
	game._process(0.1)
	require(game.player.x > start.x and game.locomotion.sliding(),"Slide moves even after movement keys are released")
	require(game.world.walkable(game.player),"Slide respects the world's collision bodies")
	require(not game.start_work(game.player+Vector2(20,0)),"Sliding cannot harvest")
	game.restart()
	require(not game.locomotion.airborne() and not game.locomotion.sliding() and game.locomotion.crouch == 0,"Restart resets all movement states")
	print("%s: %d locomotion checks, %d failures: crouch, jump, slide, momentum, collisions, anatomy, pause and reset" % ["PASS" if failures == 0 else "FAIL",checks,failures])
	game.free()
	quit(0 if failures == 0 else 1)
